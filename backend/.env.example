# Flask Configuration
# Generate a distinct random value for each signing key.
SECRET_KEY=
JWT_SECRET_KEY=
PORT=5000

# MySQL Database Configuration
# Create database in MySQL: CREATE DATABASE resume_builder_db;
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=resume_builder_db

# Set to true to automatically use local SQLite fallback if MySQL is not running
USE_SQLITE_FALLBACK=true

# Optional: Google Gemini AI Key for live model generation (built-in intelligent heuristics are active by default)
GEMINI_API_KEY=
